# Copiar como .env y completar con valores locales. El archivo .env nunca se sube al repositorio.

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inversiones_lr
DB_USER=postgres
DB_PASSWORD=cambiar_esta_clave

# Puerto del backend
SERVER_PORT=8080

# JWT: secreto de al menos 32 caracteres (generar uno aleatorio por ambiente) y duración del token
JWT_SECRET=
JWT_EXPIRACION_MINUTOS=60

# Origen del frontend permitido por CORS (varios separados por coma)
FRONTEND_URL=http://localhost:4200

# Administrador inicial: se crea al arrancar si no existe ningún Administrador
ADMIN_CORREO=
ADMIN_CONTRASENA=
