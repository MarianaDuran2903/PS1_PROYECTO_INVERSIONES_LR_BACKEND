# Copiar como backup.env junto al script y ajustar. backup.env no se sube al repositorio.
# DB_NAME y DB_USER se leen del .env del proyecto; solo se definen aquí para sobrescribirlos.

# Carpeta del proyecto (donde está docker-compose.yml). Por defecto, dos niveles arriba del script.
#PROJECT_DIR=/opt/inversiones-lr/backend
DB_SERVICE=db

# Copias locales en el servidor
BACKUP_DIR=/var/backups/inversiones-lr
RETENCION_LOCAL_DIAS=2
# 0-9: más alto = archivo más chico pero más CPU
COMPRESION=6

# Equipo de destino por SSH (dejar REMOTE_HOST vacío para no enviar)
REMOTE_HOST=
REMOTE_USER=backup
REMOTE_PORT=22
REMOTE_DIR=/srv/backups/inversiones-lr
# Llave privada sin frase de paso, usada solo para backups
SSH_KEY=/home/backup/.ssh/id_ed25519_backup
RETENCION_REMOTA_DIAS=14
# Límite de subida en KB/s (5000 = ~5 MB/s)
BWLIMIT_KBPS=5000
